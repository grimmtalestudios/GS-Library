<div class="gs-shell gs-library-appearance">
  <div class="gs-scroll gs-library-appearance-body">
    {{#each swatchGroups}}
      <section class="gs-library-appearance-field">
        <span class="gs-library-appearance-label">{{legend}}</span>
        <div class="gs-library-appearance-swatches" role="group" aria-label="{{legend}}">
          {{#each swatches}}
            <button type="button" class="gs-library-appearance-swatch" data-action="pickColour"
                    data-picks="{{../picks}}" data-colour="{{colour}}" aria-pressed="{{active}}"
                    data-tooltip="{{label}}" aria-label="{{label}}" style="--swatch: {{colour}}"></button>
          {{/each}}
          <label class="gs-library-appearance-custom{{#if isCustom}} is-active{{/if}}" style="--swatch: {{value}}"
                 data-tooltip="{{custom}}">
            <input type="color" data-picks="{{picks}}" value="{{value}}" aria-label="{{custom}}" />
            <i class="fa-solid fa-plus" inert></i>
          </label>
        </div>
      </section>
    {{/each}}
    <section class="gs-library-appearance-field">
      <span class="gs-library-appearance-label">{{localize "GRIMMTALE.settings.finish.legend"}}</span>
      <div class="gs-library-appearance-finishes" role="group"
           aria-label="{{localize 'GRIMMTALE.settings.finish.legend'}}">
        {{#each finishes}}
          <button type="button" class="gs-library-appearance-finish" data-action="pickFinish"
                  data-finish="{{key}}" aria-pressed="{{active}}">{{label}}</button>
        {{/each}}
      </div>
    </section>
    <section class="gs-library-appearance-field">
      <div class="gs-library-appearance-head">
        <span class="gs-library-appearance-label">{{localize "GRIMMTALE.settings.text.legend"}}</span>
        <span class="gs-library-appearance-score" data-verdict="{{score.verdict}}"
              data-tooltip="{{localize 'GRIMMTALE.settings.score.label'}}">
          <span class="gs-figure">{{score.value}}</span>
          <span>{{score.label}}</span>
        </span>
      </div>
      {{#each textColours}}
        <div class="gs-library-appearance-text">
          <span>{{label}}</span>
          <input type="color" data-picks="{{key}}" value="{{colour}}" aria-label="{{label}}" />
          {{#if isSet}}
            <button type="button" class="gs-icon-btn dense" data-action="clearTextColour" data-text="{{key}}"
                    data-tooltip="{{localize 'GRIMMTALE.settings.text.follow'}}"
                    aria-label="{{localize 'GRIMMTALE.settings.text.follow'}}">
              <i class="fa-solid fa-rotate-left" inert></i>
            </button>
          {{/if}}
        </div>
      {{/each}}
      {{#if score.note}}
        <p class="gs-hint">{{score.note}}</p>
      {{/if}}
    </section>
    <section class="gs-library-appearance-field">
      <div class="gs-library-appearance-head">
        <span class="gs-library-appearance-label">{{localize "GRIMMTALE.settings.presets.legend"}}</span>
        <label class="gs-library-appearance-own">
          <input type="checkbox" name="ownLook" {{checked ownLook}} />
          <span>{{localize "GRIMMTALE.settings.ownLook"}}</span>
        </label>
      </div>
      <div class="gs-library-appearance-save">
        <input type="text" name="presetName" maxlength="40" autocomplete="off"
               placeholder="{{localize 'GRIMMTALE.settings.presets.placeholder'}}"
               aria-label="{{localize 'GRIMMTALE.settings.presets.placeholder'}}" />
        <button type="button" class="gs-btn ghost" data-action="savePreset">
          <i class="fa-solid fa-floppy-disk" inert></i>
          <span>{{localize "GRIMMTALE.settings.save"}}</span>
        </button>
      </div>
      {{#if presets.length}}
        <ul class="gs-library-appearance-presets">
          {{#each presets}}
            <li class="gs-library-appearance-preset">
              <button type="button" class="gs-library-appearance-preset-apply" data-action="applyPreset"
                      data-preset="{{id}}" aria-pressed="{{active}}">
                <span class="gs-library-appearance-preset-chip" style="background: {{ground}}"></span>
                <span class="gs-library-appearance-preset-chip" style="background: {{accent}}"></span>
                <span class="gs-library-appearance-preset-name">{{name}}</span>
                <span class="gs-library-appearance-preset-finish">{{finishLabel}}</span>
              </button>
              <button type="button" class="gs-icon-btn dense" data-action="deletePreset" data-preset="{{id}}"
                      data-tooltip="{{localize 'GRIMMTALE.settings.presets.forget'}}"
                      aria-label="{{localize 'GRIMMTALE.settings.presets.forget'}} {{name}}">
                <i class="fa-solid fa-xmark" inert></i>
              </button>
            </li>
          {{/each}}
        </ul>
      {{/if}}
    </section>
    {{#unless isDefault}}
      <button type="button" class="gs-btn ghost" data-action="reset">
        <i class="fa-solid fa-rotate-left" inert></i>
        <span>{{localize "GRIMMTALE.settings.reset"}}</span>
      </button>
    {{/unless}}
  </div>
  <footer class="gs-footer">
    {{#if website}}
      <a href="{{website}}" target="_blank" rel="noopener noreferrer">{{footer}}</a>
    {{else}}
      {{footer}}
    {{/if}}
  </footer>
</div>
